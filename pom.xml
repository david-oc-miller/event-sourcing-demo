<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Project Information -->
    <groupId>com.davidocmiller</groupId>
    <artifactId>event-sourcing-demo-bom</artifactId>
    <version>0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Event Sourcing Demo Bill of Materials</name>
    <description>A showcase for application developent using event sourcing</description>
    <url>https://github.com/david-oc-miller/event-sourcing-demo</url>


    <!-- Dependencies -->
    <dependencyManagement>
        <dependencies>
            <!-- Jakarta JSON Processing (JSON-P) API -->
            <dependency>
                <groupId>jakarta.json</groupId>
                <artifactId>jakarta.json-api</artifactId>
                <version>2.1.3</version>
            </dependency>

            <dependency>
                <groupId>org.eclipse.parsson</groupId>
                <artifactId>parsson</artifactId>
                <version>1.1.7</version>
                <scope>runtime</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- License Information -->
    <licenses>
        <license>
            <name>GPL License</name>
            <url>https://opensource.org/licenses/gpl-3-0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- SCM Information -->
    <scm>
        <connection>scm:git:git://github.com/david-oc-miller/event-sourcing-demo.git</connection>
        <developerConnection>scm:git:ssh://github.com:david-oc-miller/event-sourcing-demo.git</developerConnection>
        <url>https://github.com/david-oc-miller/event-sourcing-demo/tree/main</url>
    </scm>

    <!-- Issue Management -->
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/david-oc-miller/event-sourcing-demo/issues</url>
    </issueManagement>

    <!-- Repositories -->
    <repositories>
        <repository>
            <id>central</id>
            <name>Maven Central Repository</name>
            <url>https://repo1.maven.org/maven2</url>
            <layout>default</layout>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <!-- Developer Information -->
    <developers>
        <developer>
            <id>david-oc-miller</id>
            <name>David Miller</name>
            <email>david.oc.miller@gmail.com</email>
            <roles>
                <role>Developer</role>
            </roles>
            <timezone>America/New_York</timezone>
        </developer>
    </developers>
</project>
